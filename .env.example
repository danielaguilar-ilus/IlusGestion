# ════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — Sistema ILUS Etiquetas
# ════════════════════════════════════════════════════════════
# Copia este archivo a .env (que está en .gitignore) y completa
# con tus credenciales reales. En Railway, define cada variable
# en el dashboard del proyecto.
#
# IMPORTANTE: si una variable NO está definida, config.py usa
# un valor de respaldo (hardcoded). En PRODUCCIÓN siempre define
# todas las variables aquí abajo y rota las credenciales viejas.
# ════════════════════════════════════════════════════════════

# ── Base de datos MySQL principal (Clever Cloud) ──
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── ERP Random — MySQL directo (legacy, casi sin uso) ──
ERP_MYSQL_HOST=
ERP_MYSQL_PORT=
ERP_MYSQL_USER=
ERP_MYSQL_PASSWORD=
ERP_MYSQL_DATABASE=

# ── ERP Random — REST API (la que de verdad se usa) ──
ERP_API_URL=https://lab.random.cl/ilus
ERP_API_TOKEN=

# ── Anthropic Claude (análisis de contratos PDF) ──
ANTHROPIC_API_KEY=

# ── Almacenamiento de archivos: Google Cloud Storage ──
# Único almacenamiento desde 2026-08-05 (antes Cloudinary).
# En Cloud Run la autenticación es por identidad del servicio (ADC): no hay
# clave que poner acá. En local hace falta `gcloud auth application-default
# login` o dejar ILUS_STORAGE_GCS=0 (sin subir archivos).
GCS_BUCKET=ilus-app-fotos
ILUS_STORAGE_GCS=1

# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_SECRET: ya NO se usan para guardar
# nada. Solo si quedan contratos históricos en Cloudinary que necesiten
# dirección firmada para poder abrirse (ver _cloudinary_urls_firmadas_legacy
# en app.py). Se pueden borrar en cuanto el diagnóstico de storage marque 0.

# ── SMTP (envío correos retiros, recuperación clave, etc.) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ILUS Fitness
SMTP_FROM_ADDR=
